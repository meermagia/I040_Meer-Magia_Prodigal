# Candidate DB API
CANDIDATE_API_BASE_URL=https://candidate-db-api.service.external.usea2.aws.prodigaltech.com
CANDIDATE_API_KEY=your_personal_api_key_here
# The API answers in ~3-5 s; keep this generous
CANDIDATE_API_TIMEOUT_SECONDS=20

# LLM: any OpenAI-compatible endpoint with tool calling. Gemini shown (free tier).
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.5-flash
LLM_API_KEY=your_llm_api_key_here

# Timezone for last_contacted_at and "today" in the prompt
AGENT_TIMEZONE=Asia/Kolkata
